{
  "name": "openpage-translate",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source bilingual page translation for Tampermonkey",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "format": "prettier --write src tests scripts docs README*.md *.json .github",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:publish": "node scripts/check-publish.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
